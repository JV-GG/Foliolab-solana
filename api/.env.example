# Binance Web3 API — https://web3.binance.com/en/dev-portal/project
# Copy to api/.env (git-ignored). Never commit real keys.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Optional probe inputs. Mainnet (BSC, chainId 56).
# A wallet address with some activity — yours is fine, it is only read.
PROBE_ADDRESS=
# A token contract. Defaults in endpoints.ts use WBNB where none is given.
PROBE_TOKEN=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# Any BSC transaction hash, for the transaction-detail endpoint.
PROBE_TXHASH=

# Optional. Set this if your ISP resolves Binance hostnames to a sinkhole and
# every call dies with UND_ERR_CONNECT_TIMEOUT (run `node api/doctor.ts` to
# confirm). Requests then resolve through this DNS server instead of the system
# resolver. TLS still validates against the real hostname. Leave unset if your
# DNS is healthy.
# BINANCE_WEB3_DNS=1.1.1.1
