# Folio Lab (Solana) — copy to .env.local (git-ignored) or set in Vercel.
# Anything without NEXT_PUBLIC_ is server-side only. Never give a secret a NEXT_PUBLIC_ prefix:
# that ships it to every browser.
#
# NOTE: the backend/frontend are still being ported from BNB. The Solana variables below are the
# names the ported code will read; until then the app still reads the old BSC ones.

# ---- Cluster ----------------------------------------------------------------------------------
# devnet for the hackathon demo (mock stock tokens + mock_router); mainnet-beta later (xStocks + Jupiter).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Browser RPC. The public endpoint is rate-limited; a free Helius/Triton/QuickNode devnet URL is better.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Server RPC for /api routes (can be a private URL with an API key; never exposed).
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Program and token addresses (public, not secret) -----------------------------------------
# Program IDs come from anchor/target/deploy/*-keypair.json (`anchor keys list`).
NEXT_PUBLIC_FOLIO_PROGRAM_ID=9PY9RRXQuMtHXDyvWNL5ohFrsSux5SLrJhhdtuBgLUJH
NEXT_PUBLIC_ROUTER_PROGRAM_ID=FeE32TVg1Yk4DVe4jS3SELK13dQsbbDUWyY4dYKmQhjm
# Settlement stablecoin mint. On devnet this is the mock USDC the deploy script creates;
# on mainnet it is EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
NEXT_PUBLIC_USDC_MINT=

# ---- Price signer (SECRET) --------------------------------------------------------------------
# ed25519 key that signs prices for deposit/rebalance. Its public key must equal the registry's
# `price_signer`. Generate one OUTSIDE the repo:
#   solana-keygen new --no-bip39-passphrase -o ~/folio-price-signer.json
#   solana-keygen pubkey ~/folio-price-signer.json      # give this to whoever runs initialize_registry
# Paste the JSON array from that file here (e.g. [12,34,...], 64 numbers).
PRICE_SIGNER_SECRET_KEY=
# Refuse to sign when the token price is more than this many bps from the reference price (default 200 = 2%).
PRICE_MAX_DIVERGENCE_BPS=200
# true = refuse to sign for a token the price source does not report as trading.
PRICE_REQUIRE_OPEN_MARKET=true

# ---- Price source: Binance Web3 API (SECRET) --------------------------------------------------
# Still used for US stock reference prices. https://web3.binance.com/en/dev-portal/project
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Optional: some Malaysian ISPs block Binance's DNS. Set to 1.1.1.1 if requests fail to resolve.
# BINANCE_WEB3_DNS=1.1.1.1

# ---- Mainnet only (later) ---------------------------------------------------------------------
# Jupiter swap API for rebalancing with real xStocks. Not used on devnet.
# JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
