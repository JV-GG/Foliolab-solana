# Binance Web3 API credentials — https://web3.binance.com/en/dev-portal/project
# Copy to .env.local (git-ignored) or set in Vercel. Server-side only: do NOT add a
# NEXT_PUBLIC_ prefix, which would expose the secret in the browser bundle.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Price signer for /api/prices (EIP-712). Server-side only. Its address must match
# AssetRegistry.priceSigner().
PRICE_SIGNER_PRIVATE_KEY=

# Chain RPC for backend queries (Route handlers):
# BSC Mainnet (Vercel): https://bsc-dataseed.bnbchain.org
# Local Anvil: http://127.0.0.1:8545
CHAIN_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Frontend target chain (bsc for BSC Mainnet, local for Anvil):
NEXT_PUBLIC_CHAIN=bsc
NEXT_PUBLIC_RPC_URL=https://bsc-dataseed.bnbchain.org
